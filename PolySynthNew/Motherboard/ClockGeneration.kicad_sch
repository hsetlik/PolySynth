	(text "Falling edge here\nresets both the flip flops\nthe shift registers"
		(exclude_from_sim no)
		(at 19.05 59.69 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "050495e7-0fd8-44f4-b5ae-1d8bbc7ea29f")
	)
	(text "These schmitt triggers compensate for the ~100ns of propagation delay \nintroduced by the flip flops above. Make sure U1001 and U1003 are from\nthe same logic series and manufacturer as U1006 and U1007."
		(exclude_from_sim no)
		(at 35.56 118.11 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "401bc29a-cf52-46eb-9623-2f83f9d0e01a")
	)
	(text "Note: the first rising edge on SCK should\nset all four flip-flops high, which means\nNLATCH will be high for the first 8 bits"
		(exclude_from_sim no)
		(at 30.48 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "bde83c84-7e10-4390-831f-a610f7877f16")
	)
